# CyberQuant Backend Environment Configuration Template
# NOTE: Never put real credentials, live tokens or sensitive production secrets here.

# Application Environment (development, testing, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Cryptography
# Generate a secure key in production (e.g. `openssl rand -hex 32`)
SECRET_KEY=cyberquant-insecure-dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# SQLite for local development and tests; PostgreSQL for production
# Example Postgres: postgresql+psycopg2://user:password@localhost:5432/cyberquant
DATABASE_URL=sqlite:///./cyberquant.db

# Storage and Directories
OUTPUT_BASE_DIR=./outputs
DATA_BASE_DIR=./data
MAX_UPLOAD_SIZE_BYTES=52428800

# Background Worker & Queue
# USE_IN_PROCESS_WORKER=true runs jobs in this process (local/dev).
# Set to false for production to enqueue on Redis/RQ (requires redis + rq installed
# and a running worker, e.g. `rq worker cyberquant -u redis://localhost:6379/0`).
# The server fails loudly if USE_IN_PROCESS_WORKER=false and Redis/RQ are unavailable.
REDIS_URL=redis://localhost:6379/0
USE_IN_PROCESS_WORKER=true

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Notification Service (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=placeholder-smtp-password
SMTP_FROM=alerts@cyberquant.local
SMTP_USE_TLS=true
# Set SMTP_SIMULATED=true to log emails instead of connecting to real SMTP
SMTP_SIMULATED=true

# Webhook Delivery
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_DEFAULT_SECRET=placeholder-webhook-hmac-secret

# External Threat Intelligence Feeds
EPSS_API_URL=https://api.first.org/data/v1/epss
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
THREAT_INTEL_CACHE_TTL_HOURS=24
THREAT_INTEL_OFFLINE_MODE=false

# Optional LLM Integration for Risk Copilot
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# One-click demo login (pre-seeded demo organizations). Disable in production.
ENABLE_DEMO_LOGIN=true
